{
  "name": "meteoscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "data:update:jma": "node scripts/update-jma-static-data.mjs",
    "data:update:volcano-latest": "node scripts/update-jma-volcano-latest-info.mjs",
    "data:build:map-geometry": "node scripts/build-map-display-geometry.mjs",
    "data:update:tsunami-stations": "node scripts/update-jma-tsunami-observation-stations.mjs",
    "data:update:usgs-slab2": "node scripts/build-usgs-slab2-contours.mjs",
    "data:build:usgs-surface": "node scripts/build-usgs-slab2-surface.mjs",
    "test:safety": "node Tests/PushSafetyTests.mjs",
    "test:earthquake": "node Tests/JmaEarthquakeSourceTests.mjs && node Tests/EarthquakeStationLookupTests.mjs && node Tests/EarthquakeStationCodeTests.mjs && node Tests/PlateBoundaryTests.mjs && node Tests/HypocenterDateWheelTests.mjs && node Tests/Hypocenter3DTests.mjs && node Tests/PlateDepth3DTests.mjs && node Tests/PlateDepthSurfaceTests.mjs",
    "test:volcano": "node Tests/VolcanoTests.mjs",
    "test:earthquake-worker": "node Tests/EarthquakeWorkerRouteTests.mjs",
    "test:quiz": "node Tests/DisasterQuizTests.mjs && node Tests/QuizAccountTests.mjs && node Tests/QuizStorageTests.mjs",
    "test:community": "node Tests/CommunityReportTests.mjs",
    "test:early-access": "node Tests/EarlyAccessReleaseTests.mjs",
    "test:admin": "node Tests/AdminManagementTests.mjs && node Tests/CloudflareFreeTierAnalyticsTests.mjs",
    "test:tsunami": "node Tests/TsunamiXmlTests.mjs && node Tests/TsunamiTestScenarioTests.mjs",
    "test:tide": "node Tests/TideLevelTests.mjs",
    "test:typhoon": "node Tests/TyphoonTests.mjs",
    "test:warnings": "node Tests/WarningResponsivenessTests.mjs",
    "test:amedas": "node Tests/AmedasRankingTests.mjs",
    "test:social-share": "node Tests/SocialShareTests.mjs",
    "test:location": "node Tests/CurrentLocationMarkerTests.mjs",
    "test:lightning": "node Tests/LightningTests.mjs",
    "test:weekly-weather": "node Tests/WeeklyWeatherTests.mjs",
    "test:responsive": "node Tests/ResponsiveLayoutTests.mjs",
    "test:startup": "node Tests/InitialMapLoadingTests.mjs",
    "test:consent": "node Tests/LegalConsentTests.mjs",
    "test:resilience": "node Tests/RuntimeResilienceTests.mjs",
    "data:build:warning-map": "node scripts/build-warning-geometry-fixes.mjs",
    "deploy:cloudflare": "npm run build && npx wrangler pages deploy dist --project-name meteoscope"
  },
  "dependencies": {
    "maplibre-gl": "^5.24.0",
    "pdfjs-dist": "^6.1.200"
  },
  "devDependencies": {
    "@turf/simplify": "^7.2.0",
    "@xmldom/xmldom": "^0.8.11",
    "adm-zip": "^0.6.0",
    "postcss": "^8.5.18",
    "shapefile": "^0.6.6",
    "vite": "^6.4.3"
  }
}
